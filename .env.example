# ==========================================
# License Management System - Local Environment Config
# ==========================================

# Database Connection (PostgreSQL running locally)
DATABASE_CONNECTION_STRING="Host=localhost;Port=5432;Database=LicenseManagementDb;Username=postgres;Password=your_postgres_password"

# JWT Authentication Secret (Must be at least 32 characters)
JWT_SECRET="YourSuperSecretEnterpriseJwtKey_MustBeAtLeast32CharsLong!"
JWT_ISSUER="LicenseManagementSystem"
JWT_AUDIENCE="LicenseManagementUsers"
JWT_EXPIRY_MINUTES=480

# OpenAI API Configuration (Backend Only - Never exposed to frontend)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
